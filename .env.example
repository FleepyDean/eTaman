# ===== Frontend (Vite) =====
# In production on Railway, leave this EMPTY so Nginx proxies /api/ to backend
# In development, set to http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ===== Backend (Django) =====
# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts (Railway domain auto-detected)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django secret key (generate a new one for production!)
DJANGO_SECRET_KEY=django-insecure-unye7(r(y-s(mrrsmwb6!@*n@p-_3***!(go&3@&z$@_7+&++8

# CORS: comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.up.railway.app

# CSRF trusted origins (same as CORS usually)
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.up.railway.app

# Database URL (Railway provides this when you add a PostgreSQL database)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ===== AI =====
# Google Gemini API Key (if using AI features)
VITE_GEMINI_API_KEY=
